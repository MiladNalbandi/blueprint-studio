# ─── Database ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge_dev@postgres:5432/flowforge
DATABASE_URL_SYNC=postgresql://flowforge:flowforge_dev@postgres:5432/flowforge

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── LLM Providers ──────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── App ─────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Encryption (for stored API keys) ───────
ENCRYPTION_KEY=generate-a-fernet-key-here
