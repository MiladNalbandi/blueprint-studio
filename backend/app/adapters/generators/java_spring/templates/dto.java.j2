{% if field.type == 'decimal' %}{% if needs_bigdecimal.append(true) %}{% endif %}{% endif %}
{% if field.type == 'date' %}{% if needs_localdate.append(true) %}{% endif %}{% endif %}
{% if field.type == 'datetime' %}{% if needs_localdatetime.append(true) %}{% endif %}{% endif %}
{% if field.type == 'uuid' %}{% if needs_uuid.append(true) %}{% endif %}{% endif %}
{% if not field.nullable %}
{% if field.type in ['string', 'text'] %}
{% if needs_notblank.append(true) %}{% endif %}
{% else %}
