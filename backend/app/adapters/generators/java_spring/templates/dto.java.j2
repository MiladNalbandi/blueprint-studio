@Data
public class {{ dto.name | pascal_case }} {

{% for field in dto.fields %}
{% if not field.primary %}
{% set validations_for_field = [] %}
{% for v in dto.validations if v.field == field.name %}
{% if validations_for_field.append(v) %}{% endif %}
{% endfor %}
{% if not field.nullable %}
{% if field.type in ['string', 'text'] %}
    @NotBlank
{% else %}
    @NotNull
{% endif %}
{% endif %}
{% for v in validations_for_field %}
{% if v.rule == 'email' %}
    @Email
{% elif v.rule == 'min' %}
    @Min({{ v.params.get('value', 0) }})
{% elif v.rule == 'max' %}
    @Max({{ v.params.get('value', 0) }})
{% elif v.rule == 'regex' %}
    @Pattern(regexp = "{{ v.params.get('pattern', '.*') }}")
{% endif %}
{% endfor %}
    private {{ field.type | java_type }} {{ field.name | camel_case }};

{% endif %}
{% endfor %}
