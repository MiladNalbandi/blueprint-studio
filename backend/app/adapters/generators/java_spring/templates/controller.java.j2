        this.service = service;
    }
{% endif %}

{% for ep in endpoints %}
{% if ep.method == 'GET' %}
{% if '/{' in ep.path or '/:' in ep.path %}
    @GetMapping("/{id}")
    public ResponseEntity<?> getById(@PathVariable Long id) {
{% if service_name %}
        return service.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
{% else %}
        return ResponseEntity.ok().build();
{% endif %}
    }
{% else %}
    @GetMapping
    public ResponseEntity<?> getAll() {
{% if service_name %}
        return ResponseEntity.ok(service.findAll());
{% else %}
        return ResponseEntity.ok().build();
{% endif %}
    }
{% endif %}

{% elif ep.method == 'POST' %}
{% set dto_name = ep.request_dto_name | pascal_case if ep.request_dto_name else '' %}
    @PostMapping
{% if dto_name %}
    public ResponseEntity<?> create(@Valid @RequestBody {{ dto_name }} request) {
{% else %}
    public ResponseEntity<?> create() {
{% endif %}
{% if service_name %}
        // TODO: map DTO to entity and call service.create()
        return ResponseEntity.status({{ ep.response_status | default(201) }}).build();
{% else %}
        return ResponseEntity.status({{ ep.response_status | default(201) }}).build();
{% endif %}
    }

{% elif ep.method in ['PUT', 'PATCH'] %}
{% set dto_name = ep.request_dto_name | pascal_case if ep.request_dto_name else '' %}
{% if ep.method == 'PUT' %}
    @PutMapping("/{id}")
{% else %}
    @PatchMapping("/{id}")
{% endif %}
{% if dto_name %}
    public ResponseEntity<?> update(@PathVariable Long id, @Valid @RequestBody {{ dto_name }} request) {
{% else %}
    public ResponseEntity<?> update(@PathVariable Long id) {
{% endif %}
{% if service_name %}
        // TODO: map DTO to entity and call service.update()
        return ResponseEntity.ok().build();
{% else %}
        return ResponseEntity.ok().build();
{% endif %}
    }

{% elif ep.method == 'DELETE' %}
    @DeleteMapping("/{id}")
    public ResponseEntity<?> delete(@PathVariable Long id) {
{% if service_name %}
        service.delete(id);
        return ResponseEntity.noContent().build();
{% else %}
        return ResponseEntity.noContent().build();
{% endif %}
    }

{% else %}
    @RequestMapping(value = "{{ ep.path }}", method = RequestMethod.{{ ep.method }})
    public ResponseEntity<?> handle{{ ep.method | lower | pascal_case }}() {
        // TODO: implement {{ ep.method }} {{ ep.path }}
