[tool.poetry]
name = "flowforge-generated"
version = "0.1.0"
description = "Generated by FlowForge"
authors = []

[tool.poetry.dependencies]
python = "^3.11"
{% for dep in ir.dependencies %}
{% if not dep.get('dev', False) %}
{{ dep.name }} = "{{ dep.version }}"
{% endif %}
{% endfor %}

[tool.poetry.group.dev.dependencies]
{% for dep in ir.dependencies %}
{% if dep.get('dev', False) %}
{{ dep.name }} = "{{ dep.version }}"
{% endif %}
{% endfor %}

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"
