{
  "id": "auth_jwt",
  "name": "JWT Authentication",
  "description": "JWT auth pattern with login, register, and profile endpoints, auth middleware, and user entity.",
  "icon": "shield",
  "nodes": [
    {
      "tempId": "entity-user",
      "type": "entity",
      "label": "User",
      "position": { "x": 900, "y": 250 },
      "config": {
        "tableName": "users",
        "fields": [
          { "name": "id", "type": "integer", "primary": true },
          { "name": "email", "type": "string", "unique": true },
          { "name": "password_hash", "type": "string" },
          { "name": "created_at", "type": "datetime" }
        ],
        "relations": [],
        "indexes": [
          { "columns": ["email"], "unique": true, "name": "idx_users_email" }
        ]
      }
    },
    {
      "tempId": "endpoint-login",
      "type": "endpoint",
      "label": "Login",
      "position": { "x": 0, "y": 0 },
      "config": {
        "method": "POST",
        "path": "/api/auth/login",
        "description": "Authenticate user and return JWT token"
      }
    },
    {
      "tempId": "endpoint-register",
      "type": "endpoint",
      "label": "Register",
      "position": { "x": 0, "y": 200 },
      "config": {
        "method": "POST",
        "path": "/api/auth/register",
        "description": "Register a new user account"
      }
    },
    {
      "tempId": "endpoint-me",
      "type": "endpoint",
      "label": "Get Profile",
      "position": { "x": 0, "y": 400 },
      "config": {
        "method": "GET",
        "path": "/api/auth/me",
        "description": "Get current authenticated user profile"
      }
    },
    {
      "tempId": "middleware-auth",
      "type": "middleware",
      "label": "Auth Middleware",
      "position": { "x": 200, "y": 400 },
      "config": {
        "type": "auth",
        "description": "Validates JWT token and attaches user to request"
      }
    },
    {
      "tempId": "dto-login",
      "type": "dto",
      "label": "LoginDTO",
      "position": { "x": 250, "y": 0 },
      "config": {
        "fields": [
          { "name": "email", "type": "string" },
          { "name": "password", "type": "string" }
        ],
        "description": "Login request payload"
      }
    },
    {
      "tempId": "dto-register",
      "type": "dto",
      "label": "RegisterDTO",
      "position": { "x": 250, "y": 200 },
      "config": {
        "fields": [
          { "name": "email", "type": "string" },
          { "name": "password", "type": "string" },
          { "name": "name", "type": "string" }
        ],
        "description": "Registration request payload"
      }
    },
    {
      "tempId": "service-auth",
      "type": "service",
      "label": "AuthService",
      "position": { "x": 500, "y": 200 },
      "config": {
        "name": "AuthService",
        "methods": ["register", "login", "validateToken", "getCurrentUser"],
        "description": "Authentication and authorization business logic"
      }
    },
    {
      "tempId": "repo-user",
      "type": "repository",
      "label": "UserRepository",
      "position": { "x": 700, "y": 250 },
      "config": {
        "entity": "User",
        "methods": ["findAll", "findById", "findByEmail", "save", "delete"]
      }
    },
    {
      "tempId": "response-200",
      "type": "response",
      "label": "200 OK",
      "position": { "x": 300, "y": 500 },
      "config": {
        "status": 200,
        "type": "json",
        "description": "Successful authentication / profile response"
      }
    },
    {
      "tempId": "response-201",
      "type": "response",
      "label": "201 Created",
      "position": { "x": 300, "y": 600 },
      "config": {
        "status": 201,
        "type": "json",
        "description": "User registered successfully"
      }
    },
    {
      "tempId": "response-401",
      "type": "response",
      "label": "401 Unauthorized",
      "position": { "x": 500, "y": 500 },
      "config": {
        "status": 401,
        "type": "json",
        "description": "Invalid credentials or expired token"
      }
    }
  ],
  "edges": [
    { "source": "endpoint-login", "target": "dto-login", "label": "validates" },
    { "source": "endpoint-register", "target": "dto-register", "label": "validates" },
    { "source": "endpoint-me", "target": "middleware-auth", "label": "protected" },
    { "source": "endpoint-login", "target": "service-auth", "label": "login" },
    { "source": "endpoint-register", "target": "service-auth", "label": "register" },
    { "source": "middleware-auth", "target": "service-auth", "label": "validateToken" },
    { "source": "endpoint-me", "target": "service-auth", "label": "getCurrentUser" },
    { "source": "service-auth", "target": "repo-user", "label": "uses" },
    { "source": "repo-user", "target": "entity-user", "label": "maps" },
    { "source": "endpoint-login", "target": "response-200", "label": "returns token" },
    { "source": "endpoint-login", "target": "response-401", "label": "invalid credentials" },
    { "source": "endpoint-register", "target": "response-201", "label": "returns" },
    { "source": "endpoint-me", "target": "response-200", "label": "returns profile" },
    { "source": "endpoint-me", "target": "response-401", "label": "unauthorized" }
  ]
}
